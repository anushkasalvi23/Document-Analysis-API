# Must match API_KEY in server/.env (same string, no quotes).
VITE_API_KEY=add your api key here

# Clerk — https://dashboard.clerk.com
# Use Development keys (pk_test_…) locally; on Vercel use Production keys (pk_live_…) from the Production instance.
# Production → Configure → Domains: add your Vercel URL (e.g. https://your-app.vercel.app).
# Paths / Redirect URLs: allow https://your-app.vercel.app/* (or Clerk’s suggested SSO callback paths).
VITE_CLERK_PUBLISHABLE_KEY=

# From https://openrouter.ai/keys — must start with sk-or-v1- (not the same as API_KEY)
OPENROUTER_API_KEY=add your api key here
API_KEY=add your api key here

# MongoDB Atlas: Project → Database → Connect → Drivers → copy URI.
# Replace <password> with your Database user password. Special chars must be URL-encoded (@ %40, # %23, : %3A).
# Atlas → Network Access: add your IP or 0.0.0.0/0 for local dev only.
# After changing MONGODB_URI, restart uvicorn (cached client will not pick up edits otherwise).
# Image uploads are stored as base64 on the document (max ~10MB decoded per image).
MONGODB_URI=
# MONGODB_DB=sumdoc

# Optional: full path to tesseract.exe if not found (Windows default install is auto-detected).
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
